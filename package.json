{
  "name": "polymarket-trader-research",
  "version": "1.0.0",
  "private": true,
  "description": "Polymarket trader onchain investigation, execution analysis, and paper-only replication research",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "probe": "node src/probe.js",
    "research:collect": "node src/trader_research.js collect",
    "research:enrich": "node src/trader_research.js enrich",
    "research:onchain": "node src/trader_research.js onchain",
    "research:analyze": "node src/trader_research.js analyze",
    "research:tape": "node src/trader_research.js tape",
    "research:triggers": "node src/research/trigger_transactions.js",
    "research:prospective-audit": "node src/research/prospective_audit.js",
    "research:esports-state": "${PYTHON:-python3} src/research/esports_state_analysis.py",
    "research:dota-heldout": "${PYTHON:-python3} src/research/dota_market_backtest.py --window-registered-before-review",
    "research:live-probe": "node src/research/live_edge_probe.js capture",
    "research:live-summary": "node src/research/live_edge_probe.js summarize --input research/djdjdjekekek/prospective/live_probe_validation.ndjson.gz --summary research/djdjdjekekek/prospective/live_probe_validation.json",
    "research:sports-reaction": "node src/research/live_edge_probe.js sports-reaction --input research/djdjdjekekek/prospective/esports_reaction_capture.ndjson.gz --summary research/djdjdjekekek/prospective/esports_reaction_analysis.json",
    "research:cs2-case": "node src/research/cs2_case_audit.js",
    "research:live-replay": "node src/research/live_edge_probe.js replay",
    "research:esports-suite": "npm run research:prospective-audit && npm run research:esports-state && npm run research:dota-heldout && npm run research:live-summary && npm run research:sports-reaction && npm run research:cs2-case",
    "research:capacity-data": "${PYTHON:-python3} src/research/capacity_data.py",
    "research:edge": "${PYTHON:-python3} src/research/edge_analysis.py",
    "research:graphics": "${PYTHON:-python3} src/research/report_graphics.py",
    "research:essay": "node src/research/plain_english_essay.js",
    "research:essay:pdf": "node src/research/plain_english_essay.js --pdf",
    "research:peers": "${PYTHON:-python3} src/research/peer_analysis.py",
    "research:stats": "${PYTHON:-python3} src/research/statistical_analysis.py",
    "research:replicate": "node src/trader_research.js replicate",
    "research:monitor": "node src/trader_research.js monitor",
    "research:report": "node src/trader_research.js report",
    "research:publish": "npm run research:graphics && npm run research:report && npm run research:essay:pdf",
    "research:all": "node src/trader_research.js all && npm run research:tape && npm run research:triggers && npm run research:stats && npm run research:edge && npm run research:capacity-data && npm run research:edge && npm run research:esports-suite && npm run research:graphics && npm run research:peers && node src/trader_research.js replicate && node src/trader_research.js report && npm run research:essay",
    "test": "node --test test/*.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2",
    "ws": "^8.16.0"
  }
}
