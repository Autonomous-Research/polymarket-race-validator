{
  "name": "polymarket-trader-research",
  "version": "1.0.0",
  "private": true,
  "description": "Polymarket trader onchain investigation, execution analysis, and paper-only replication research",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "probe": "node src/probe.js",
    "research:collect": "node src/trader_research.js collect",
    "research:enrich": "node src/trader_research.js enrich",
    "research:onchain": "node src/trader_research.js onchain",
    "research:analyze": "node src/trader_research.js analyze",
    "research:tape": "node src/trader_research.js tape",
    "research:edge": "${PYTHON:-python3} src/research/edge_analysis.py",
    "research:graphics": "${PYTHON:-python3} src/research/report_graphics.py",
    "research:peers": "${PYTHON:-python3} src/research/peer_analysis.py",
    "research:stats": "${PYTHON:-python3} src/research/statistical_analysis.py",
    "research:replicate": "node src/trader_research.js replicate",
    "research:monitor": "node src/trader_research.js monitor",
    "research:report": "node src/trader_research.js report",
    "research:all": "node src/trader_research.js all && npm run research:tape && npm run research:stats && npm run research:edge && npm run research:graphics && npm run research:peers && node src/trader_research.js replicate && node src/trader_research.js report",
    "test": "node --test test/*.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2",
    "ws": "^8.16.0"
  }
}
